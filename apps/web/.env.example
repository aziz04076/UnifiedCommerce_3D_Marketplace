# ── Store Identity ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STORE_NAME=My Shop

# ── Razorpay (replace with your OWN account keys — one set per client store) ─
# Get keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# ── Encryption (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))") ─
ENCRYPTION_KEY=64_hex_characters_here

# ── Email (optional — for login alerts and order confirmations) ───────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASS=your_password

# ── Sentry (optional — for error monitoring) ──────────────────────────────────
# SENTRY_DSN=https://your-dsn@sentry.io/project

# ── Node environment ──────────────────────────────────────────────────────────
NODE_ENV=development
